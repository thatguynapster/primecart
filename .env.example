# PrimeCart environment variables
# Copy to .env.local and fill in. Never commit the filled-in file.

# ---------------------------------------------
# Database — MongoDB Atlas
# ---------------------------------------------
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority"

# ---------------------------------------------
# Auth — Clerk
# ---------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx

# ---------------------------------------------
# Payments — Paystack
# ---------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
# Subscription plan. Test-mode plan below; swapped for the live plan at deploy.
PAYSTACK_PLAN_CODE=PLN_2b0d04ozbt798kj

# ---------------------------------------------
# Cron — cron-job.org calls the expiry endpoints over the public internet,
# so both cron routes require this bearer token. Generate a long random string
# and set the identical value in the cron-job.org Authorization header.
# ---------------------------------------------
CRON_SECRET=

# ---------------------------------------------
# Image storage — Cloudflare R2 (accessed via @aws-sdk/client-s3)
# Supplied by the project owner when the product module is built.
# ---------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL — product images are served directly, no signed requests.
R2_PUBLIC_URL=

# ---------------------------------------------
# App
# ---------------------------------------------
# Root domain, used for subdomain resolution. No protocol.
NEXT_PUBLIC_ROOT_DOMAIN=primecart.app
