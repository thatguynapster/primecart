// PrimeCart — Prisma schema
//
// Prisma is pinned to 6.19.x. Do not upgrade to v7 — it drops MongoDB support.
//
// Multi-tenancy: every document is scoped by merchantId, and every query must
// filter on it first. merchantId is always derived from the Clerk session
// server-side — never accepted from the client.
//
// Embedded types (MerchantStorefront, ProductVariant, OrderLineItem,
// ShippingAddress) cannot be written through standard Prisma Client methods on
// MongoDB. All writes touching them go through prisma.$runCommandRaw — see
// src/lib/db/embedded.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// MERCHANT
// ============================================
model Merchant {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Clerk owns authentication — no password is ever stored here.
  // This is the only supported way to resolve a session to a merchant.
  clerkUserId String @unique

  email     String   @unique
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storefront MerchantStorefront?

  // Paystack. Subaccount is created at onboarding with percentage_charge: 0 —
  // the 3% is applied per-transaction via transaction_charge at initialization.
  paystackSubaccountCode String?

  products  Product[]
  orders    Order[]
  customers Customer[]

  // No @@index([email]) or @@index([clerkUserId]) — @unique already creates
  // those indexes, and declaring them twice fails schema validation.
}

// storefront.subdomain and storefront.customDomain need indexes that Prisma
// cannot declare on embedded types. They are created by prisma/indexes.ts.
type MerchantStorefront {
  subdomain    String
  customDomain String?
  businessName String
  logoUrl      String?
  primaryColor String  @default("#000000")
  description  String?
  isActive     Boolean @default(true)

  // When onboarding completed and the shop actually went live — distinct from
  // Merchant.createdAt (signup), which can precede this by days if onboarding
  // isn't finished right away. Drives D-17's 30-day dormancy grace period, so
  // a brand-new shop isn't flagged before it's had a fair chance to sell.
  createdAt DateTime @default(now())

  // Phase 14 — storefront redesign. Both optional: unset, the hero falls back
  // to businessName/description and the mid-page banner section is skipped
  // outright (there is no sensible fallback content for a second banner).
  heroHeadline   String?
  heroSubheading String?
  heroImageUrl   String?

  // A second, independent slot from the hero's — same shape, but its own
  // content so the page does not show the same banner twice (Phase 14 spec).
  bannerHeadline   String?
  bannerSubheading String?
  bannerImageUrl   String?

  // Footer socials (14.20) — all optional, each icon only renders once set.
  // WhatsApp in place of the reference's LinkedIn: this merchant profile
  // (small Ghanaian shops) already sells over WhatsApp day to day, matching
  // the same reasoning D-15's parked `whatsappNumber` proposal made —
  // LinkedIn does not fit this audience the way it fits Lumixio's.
  facebookUrl    String?
  instagramUrl   String?
  whatsappNumber String?
}

// ============================================
// PRODUCT
// ============================================
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  merchantId  String   @db.ObjectId
  name        String
  description String?
  category    String?
  images      String[]
  isActive    Boolean  @default(true)
  // Phase 14 — merchant-curated "Featured Collection" section, distinct from
  // Best Sellers (sales-derived) and New Arrivals (recency-derived).
  isFeatured  Boolean  @default(false)

  // DEV-7 (Phase 15). Shopper-supplied personalisation (engraving, a name, an
  // insignia). Off by default. Existing products are backfilled to false —
  // `@default` only applies on create, not to existing documents (see
  // scripts/backfill-customization.mjs).
  allowCustomization Boolean @default(false)
  // Prompt shown to the shopper, e.g. "Name to engrave". Falls back to
  // "Personalisation" when null.
  customizationLabel String?
  // Hard cap enforced server-side. Null -> 30. Max accepted 200.
  customizationMaxLength Int?
  // When true, the product can't be added to the cart without text.
  customizationRequired Boolean @default(false)
  // Flat surcharge per unit when the shopper enters text, in GHS. Null/0 = free.
  customizationFee Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
  merchant Merchant         @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([merchantId, isActive])
  @@index([merchantId, category])
}

// Variants are embedded and have no independent existence. Do not create a
// separate collection for them.
type ProductVariant {
  id                String   @default(cuid())
  name              String
  sku               String?
  price             Float
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  attributes        Json
  isActive          Boolean  @default(true)

  // DEV-6 (Phase 15). What the merchant paid for one unit. Optional: null
  // means "unknown", which is NOT the same as 0. Unknown-cost sales are left
  // out of profit and counted in the coverage figure. Never sent to the
  // storefront (see src/lib/storefront/catalogue.ts's PublicVariant).
  costPrice         Float?

  // References into the parent Product.images — this option does not own
  // uploads of its own. Keeping photos on the product means a shared shot is
  // uploaded once, and the per-product cap still means something.
  //
  // Empty is meaningful: the option shows all of the product's photos.
  imageUrls         String[]

  // Set when a low-stock notification has been sent for the current dip below
  // lowStockThreshold; cleared when stock rises back above it. Dedupe marker
  // only — a merchant recounting their own stock never sets or reads this,
  // only reserveStock/restoreStock touch it (see docs/NOTIFICATIONS.md).
  lowStockAlertedAt DateTime?
}

// ============================================
// CUSTOMER
// ============================================
model Customer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  merchantId String   @db.ObjectId
  name       String
  email      String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  orders   Order[]

  @@index([merchantId])
  @@index([merchantId, email])
  @@index([merchantId, phone])
}

// ============================================
// ORDER
// ============================================
model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  merchantId  String      @db.ObjectId
  customerId  String?     @db.ObjectId
  orderNumber String
  status      OrderStatus @default(PENDING)
  source      OrderSource @default(MANUAL)

  paymentStatus PaymentStatus @default(UNPAID)
  paymentRef    String?

  subtotal Float
  total    Float

  // DEV-6 (Phase 15). PrimeCart's cut on this order, in GHS, at the rate/cap
  // in force when it was placed. 0 for MANUAL/WHATSAPP orders. Null only on
  // storefront orders created before this field existed (see
  // getProfitSummary's fee fallback in src/lib/dashboard/queries.ts).
  platformFee Float?

  lineItems       OrderLineItem[]
  shippingAddress ShippingAddress?

  // Stock is reserved (hard decrement) at order creation. This holds the
  // 30-minute deadline for payment, and is cleared once payment is confirmed
  // or the order is expired by the cron job.
  reservedUntil DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([merchantId])
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@index([merchantId, orderNumber])
  @@index([paymentRef])
  // Drives the expiry cron's lookup of abandoned reservations.
  @@index([status, paymentStatus, reservedUntil])
}

// Snapshot pattern: product name, variant name, SKU and price are copied in at
// order time. Never read live product data from a historical order.
type OrderLineItem {
  productId   String
  variantId   String
  productName String
  variantName String
  sku         String?
  price       Float
  quantity    Int
  subtotal    Float

  // DEV-6 (Phase 15) snapshot, copied from the variant at order time. Null on
  // every order placed before this shipped, and on any line whose variant had
  // no cost.
  costPrice Float?

  // DEV-7 (Phase 15) snapshots. Null on every non-customized line and all
  // historical orders. The label is snapshotted too, so renaming the prompt
  // later doesn't change what an old order says was asked.
  customization      String?
  customizationLabel String?
  customizationFee   Float?
}

type ShippingAddress {
  name    String
  phone   String
  address String
  city    String
  region  String?
}

// ============================================
// ENUMS
// ============================================
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  // Set by the expiry cron when a checkout is abandoned and the stock
  // reservation lapses. Never selectable by a merchant — CANCELLED is the
  // merchant's deliberate cancellation.
  EXPIRED
}

enum OrderSource {
  STOREFRONT
  MANUAL
  WHATSAPP // deferred to Phase 2 — placeholder only
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  REFUNDED
}
