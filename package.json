{
	"name": "primecart",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "rm -rf .next && next dev",
		"build": "node scripts/require-vercel-build.mjs && prisma generate && next build",
		"vercel-build": "node scripts/check-production-env.mjs && prisma generate && npm run db:backup && npm run db:push && npm run db:backfill && npm run db:backfill-d18 && next build",
		"start": "next start",
		"lint": "eslint",
		"test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
		"env:check": "node --env-file=.env.prod scripts/check-production-env.mjs --local",
		"test:db": "node scripts/test-db-scripts.mjs",
		"db:push": "prisma db push && node prisma/indexes.mjs",
		"db:indexes": "node prisma/indexes.mjs",
		"db:backup": "node scripts/backup-db.mjs",
		"db:restore": "node scripts/restore-db.mjs",
		"db:backfill": "node scripts/backfill-customization.mjs",
		"db:backfill-d18": "node scripts/backfill-d18.mjs",
		"db:list-merchants": "node --env-file-if-exists=.env scripts/list-merchants.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1110.0",
		"@base-ui/react": "^1.7.0",
		"@clerk/nextjs": "^7.7.4",
		"@phosphor-icons/react": "^2.1.10",
		"@prisma/client": "6.19.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"country-flag-icons": "1.6.20",
		"libphonenumber-js": "1.13.17",
		"lucide-react": "^1.31.0",
		"mongodb": "^6.22.0",
		"next": "16.4.6",
		"prisma": "6.19.3",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-phone-number-input": "3.4.18",
		"resend": "^6.20.0",
		"sharp": "^0.35.5",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.4.6",
		"mongodb-memory-server-core": "^10.4.3",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
